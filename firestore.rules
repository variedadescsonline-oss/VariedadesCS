rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Colección de prueba para verificar conectividad
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catálogo de Productos e Inventario
    match /productos/{productoId} {
      allow read: if true;
      allow write: if isValidId(productoId);
    }

    // Registro de Ventas
    match /ventas/{ventaId} {
      allow read: if true;
      allow write: if isValidId(ventaId);
    }

    // Gestión de Créditos
    match /creditos/{creditoId} {
      allow read: if true;
      allow write: if isValidId(creditoId);
    }

    // Historial de Abonos
    match /abonos/{abonoId} {
      allow read: if true;
      allow write: if isValidId(abonoId);
    }

    // Directorio de Clientes
    match /clientes/{clienteId} {
      allow read: if true;
      allow write: if isValidId(clienteId);
    }

    // Directorio de Proveedores
    match /proveedores/{proveedorId} {
      allow read: if true;
      allow write: if isValidId(proveedorId);
    }

    // Registro de Compras
    match /compras/{compraId} {
      allow read: if true;
      allow write: if isValidId(compraId);
    }

    // Movimientos de Caja Chica
    match /caja/{cajaId} {
      allow read: if true;
      allow write: if isValidId(cajaId);
    }

    // Configuración de Moneda y Tipo de Cambio
    match /configuracion/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Tipo de cambio bancos e historial
    match /tipo_cambio/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }
  }
}
